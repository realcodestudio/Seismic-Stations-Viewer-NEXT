# Local development only: copy this file to .env.development.local (NOT .env.local,
# which `next build` also reads and would bake the key into the static export).
#
# Production leaves this unset and reads the token from the Pages Function at
# /api/mapbox-token, backed by an encrypted project secret:
#   npx wrangler pages secret put MAPBOX_TOKEN --project-name <project>
NEXT_PUBLIC_MAPBOX_TOKEN=
